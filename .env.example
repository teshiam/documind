# ---------- Database (matches docker-compose.yml) ----------
DATABASE_URL=postgresql://documind:documind@localhost:5432/documind

# ---------- Answer mode ----------
# FREE, no key needed: returns the best-matching passages with citations.
LLM_PROVIDER=extractive

# --- Free real-LLM options (OpenAI-compatible). Uncomment ONE block. ---
# Free-tier limits change often, so check each provider's page.
#
# Groq (key: https://console.groq.com/keys)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your-groq-key
# LLM_MODEL=llama-3.3-70b-versatile
#
# Google Gemini (key: https://aistudio.google.com/apikey)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-gemini-key
# LLM_MODEL=gemini-2.5-flash
#
# OpenRouter (key: https://openrouter.ai/keys, models ending in :free)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your-openrouter-key
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
# Ollama, fully local and offline (install from https://ollama.com, then `ollama pull llama3.2`)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=llama3.2
#
# Paid option: Claude
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-key
# LLM_MODEL=claude-sonnet-5-5

# ---------- Embeddings (always local and free) ----------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ---------- Retrieval ----------
TOP_K=5
MIN_SCORE=0.30
CHUNK_MAX_CHARS=1000
CHUNK_OVERLAP=150

# ---------- CORS (comma-separated; add your deployed frontend URL) ----------
CORS_ORIGINS=http://localhost:3000
